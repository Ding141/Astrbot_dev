# Reference only; the deployment script creates .env using the real MagicDNS name.
TZ=Asia/Shanghai
VIKUNJA_PUBLIC_URL=https://astrbot.example-tailnet.ts.net/
# The signing secret is stored in runtime/secrets/vikunja_secret.
# Run deploy-server.sh --cn for documented Chinese package mirrors.
